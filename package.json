{
  "name": "smartspace-product-scraper",
  "version": "2.0.0",
  "description": "Category-driven product scraping and normalization system for SmartSpaceAI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "scrape": "tsx src/cli.ts",
    "scrape:all": "tsx src/cli.ts --all",
    "scrape:resume": "tsx src/cli.ts --all --resume",
    "scrape:category": "tsx src/cli.ts --category",
    "scrape:list": "tsx src/cli.ts --list-categories",
    "scrape:dry-run": "tsx src/cli.ts --all --dry-run",
    "clean": "tsx src/clean-products.ts",
    "validate-images": "python3 validate_image_urls.py",
    "test": "vitest run"
  },
  "keywords": [
    "scraper",
    "smartspaceai",
    "ecommerce",
    "interior-design"
  ],
  "author": "SmartSpaceAI Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^12.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
